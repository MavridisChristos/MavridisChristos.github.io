---
layout: default
---
<div class="about-page">
  <div class="row about-row{% if page.profile.align == 'right' %} about-row-reversed{% endif %}">
    <div class="col-md-4 col-lg-3 about-sidebar-col">
      <div class="about-sidebar">
        {% if page.profile %}
          <div class="about-sidebar-header">
            {% if page.profile.image %}
              {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
              {% if page.profile.image_circular %}
                {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
              {% else %}
                {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
              {% endif %}
              {%
                include figure.liquid loading="eager" path=profile_image_path class=profile_image_class alt=page.profile.image
                cache_bust=true
              %}
            {% endif %}

            <div class="about-sidebar-header-text">
              <h1 class="about-name">
                {% if site.title == 'blank' %}
                  <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
                  {{ site.last_name }}
                {% else %}
                  {{ site.title }}
                {% endif %}
              </h1>
              {% if page.subtitle %}<p class="about-subtitle">{{ page.subtitle }}</p>{% endif %}

              {% if page.profile.more_info %}
                <div class="address d-none d-md-block">
                  {{ page.profile.more_info }}
                </div>
              {% endif %}

              <div class="about-sidebar-contact">
                {% if page.profile.more_info %}
                  <details class="address-toggle d-md-none">
                    <summary aria-label="Show contact details"><i class="fa-solid fa-chevron-down"></i></summary>
                    <div class="address">
                      {{ page.profile.more_info }}
                    </div>
                  </details>
                {% endif %}

                <!-- Social -->
                {% if page.social %}
                  <div class="social">
                    <div class="contact-icons">{% include social.liquid %}</div>

                    <div class="contact-note">{{ site.contact_note }}</div>
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="col-md-8 col-lg-9 about-main-col">
      <article class="about-main">
        <div class="clearfix">{{ content }}</div>

        <!-- Latest posts -->
        {% if page.latest_posts %}
          <h2>
            <a href="{{ '/blog/' | relative_url }}" style="color: inherit">Latest Events</a>
          </h2>
          {% include latest_posts.liquid %}
          <hr>
        {% endif %}

        <!-- News -->
        {% if page.news %}
          <h2>
            <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
          </h2>
          {% include news.liquid %}
          <div class="news-spacer"></div>
        {% endif %}

        <!-- Selected papers -->
        {% if page.selected_papers %}
          <h2>
            <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected Publications</a>
          </h2>
          {% include selected_papers.liquid %}
        {% endif %}

        {% if site.newsletter.enabled and site.footer_fixed %}
          {% include scripts/newsletter.liquid center=true %}
        {% endif %}
      </article>
    </div>
  </div>
</div>
